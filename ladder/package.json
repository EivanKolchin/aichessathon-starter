{
  "name": "chess-ladder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.toml",
    "deploy": "wrangler deploy --config ../wrangler.toml",
    "schema": "wrangler d1 execute chess-ladder --config ../wrangler.toml --remote --file=./schema.sql",
    "schema:local": "wrangler d1 execute chess-ladder --config ../wrangler.toml --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
